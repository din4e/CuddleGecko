# Copy to .env and fill in real values before running `docker compose up -d`.
#   cp .env.example .env

# === MySQL credentials ===
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=cuddlegecko
MYSQL_USER=cg
MYSQL_PASSWORD=change_me_cg

# === App ===
# Generate with: openssl rand -hex 32
# Must be at least 32 characters — the server refuses to start otherwise.
CG_JWT_SECRET=replace_with_64_char_random_hex_string
