# Copy to .env and fill in real values before running `docker compose up -d`.
#   cp .env.example .env

# === MySQL credentials ===
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=cuddlegecko
MYSQL_USER=cg
MYSQL_PASSWORD=change_me_cg

# === App ===
# Generate with: openssl rand -hex 32
# Must be at least 32 characters — the server refuses to start otherwise.
CG_JWT_SECRET=replace_with_64_char_random_hex_string

# === HTTPS / SSL ===
# Master switch. false = plain HTTP (current behavior). true = terminate TLS in the web container.
SSL_ENABLED=false
# Certificate source: selfsigned | letsencrypt | manual
SSL_MODE=selfsigned
# Primary domain (selfsigned CN/SAN, LE issuance, manual = info only)
SSL_DOMAIN=cuddlegecko.example.com
# Comma-separated extra SANs (more domains or LAN IPs), e.g. api.example.com,192.168.31.4
SSL_EXTRA_DOMAINS=
# Let's Encrypt registration email (letsencrypt only)
SSL_EMAIL=admin@example.com
# Host dir holding certs; mounted into the container as /etc/nginx/certs
SSL_CERT_DIR=./data/certs
# LE challenge: webroot (needs public :80) | dns (needs DNS provider API, good for NAT)
SSL_LE_CHALLENGE=webroot
# acme.sh DNS provider, e.g. dns_cf / dns_dp (only when SSL_LE_CHALLENGE=dns; also set provider API env)
SSL_LE_DNS_PROVIDER=
# selfsigned: true = generate a local root CA then sign the server cert (mobile trusts ONE CA)
SSL_USE_CA=false
# HSTS header on HTTPS responses (only meaningful for long-term HTTPS; near-irreversible)
SSL_HSTS=true
# LE staging endpoint (rate-limit-friendly; use to test issuance without a real cert). true | false
SSL_LE_STAGING=false
